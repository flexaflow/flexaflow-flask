# Copy to .env and edit. Never commit .env.

# Required in production: a long random string (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# SQLite by default. For MySQL: mysql+pymysql://user:password@host/dbname (and set FLASK_ENV=production)
DATABASE_URL=sqlite:////data/cms.db

# 1 when the site is served over HTTPS (secure cookies + HSTS)
SESSION_COOKIE_SECURE=1

# 1 when running behind nginx / a load balancer so client IPs and https are read from X-Forwarded-* headers
FLEXAFLOW_BEHIND_PROXY=1

# Key that encrypts 2FA secrets. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, one is created in instance/twofa.key (back that file up separately from the database).
FLEXAFLOW_2FA_KEY=

# 1 to allow administrators to upload extension/theme zips (they run Python code)
FLEXAFLOW_ALLOW_EXTENSION_UPLOAD=0

LOG_LEVEL=INFO

# Public page cache: FileSystemCache (default), SimpleCache, RedisCache or NullCache
CACHE_TYPE=FileSystemCache
CACHE_TIMEOUT=300
# CACHE_REDIS_URL=redis://localhost:6379/0

# Extra image formats generated on upload (comma separated): webp, avif
FLEXAFLOW_IMAGE_FORMATS=webp
